# ThaiLLM API configuration for the EmoRelief AI backend.
# 1. Copy this file to ".env" in the same folder (PathummaLLM\.env)
# 2. Paste your own API key from https://thaillm.or.th
# Never commit the real .env file.
THAILLM_API_KEY=your-thaillm-api-key-here
THAILLM_BASE_URL=http://thaillm.or.th/api/v1
THAILLM_MODEL=pathumma
